# Copy to .env and fill in. .env is gitignored; .env.example is committed.

# LLM provider (wired as the reasoning phases land).
# ANTHROPIC_API_KEY=

# OpenTelemetry: leave unset to use the default console span exporter (live monitoring is
# on out of the box). Set to ship spans to a collector instead.
# OTEL_EXPORTER_OTLP_ENDPOINT=
